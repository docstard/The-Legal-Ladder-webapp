# ==========================================
# DATABASE (Neon PostgreSQL)
# ==========================================
# Get your DATABASE_URL from: https://console.neon.tech
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://username:password@ep-xxx.region.aws.neon.tech/database?sslmode=require"

# ==========================================
# CLERK AUTHENTICATION
# ==========================================
# Get your keys from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clerk redirect URLs (adjust based on your domain)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ==========================================
# APPLICATION SETTINGS
# ==========================================
# Set to 'production' when deploying, 'development' for local dev
NODE_ENV=development

# Your application URL (change for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Base URL (auto-detected if not set)
# Leave empty for auto-detection based on NODE_ENV
NEXT_PUBLIC_API_URL=

# ==========================================
# WHATSAPP INTEGRATION
# ==========================================
# Your WhatsApp number (with country code, no + or spaces)
# Example: 919876543210 for India
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# ==========================================
# OPTIONAL: ANALYTICS & MONITORING
# ==========================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# SENTRY_DSN=
